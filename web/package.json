{
  "name": "uno-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e:classic": "node e2e/classic-match.cjs",
    "test:e2e:mixed-mobile-team": "node e2e/mixed-mobile-team.cjs",
    "test:e2e:mixed-ios-team": "UNO_E2E_PLATFORM=iOS node e2e/mixed-mobile-team.cjs",
    "test:e2e:mixed-android-team": "UNO_E2E_PLATFORM=Android node e2e/mixed-mobile-team.cjs",
    "test:e2e:ios-team-chat": "UNO_E2E_PLATFORM=iOS UNO_E2E_MOBILE_CHAT=1 node e2e/mixed-mobile-team.cjs",
    "test:e2e:android-team-chat": "UNO_E2E_PLATFORM=Android UNO_E2E_MOBILE_CHAT=1 node e2e/mixed-mobile-team.cjs",
    "test:e2e:ios-voice-signaling": "UNO_E2E_PLATFORM=iOS UNO_E2E_MOBILE_VOICE=1 node e2e/mixed-mobile-team.cjs",
    "test:e2e:android-voice-signaling": "UNO_E2E_PLATFORM=Android UNO_E2E_MOBILE_VOICE=1 node e2e/mixed-mobile-team.cjs",
    "test:e2e:voice": "node e2e/team-voice.cjs",
    "test:e2e:voice-revoke": "UNO_E2E_VOICE_REVOKE=1 node e2e/team-voice.cjs"
  },
  "dependencies": {
    "livekit-client": "2.22.3",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  }
}
